---
import {
	foods,
	modules,
	pois,
	sources,
	tripDays,
	weather,
} from "../data/chongqing";

const foodAreas = ["全部", "解放碑", "两路口", "观音桥", "南岸", "武隆"];
const foodKinds = ["全部", ...new Set(foods.map((item) => item[2]))];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>重庆旅行控制台 · 6人自由行 · 已归档</title>
		<meta
			name="description"
			content="2026年8月14日至22日，六名大学生的模块化重庆旅行决策系统。行程已结束，页面转为行程记录。"
		/>
		<meta property="og:title" content="重庆旅行控制台" />
		<meta property="og:description" content="不是赶路，是随时选路。" />
		<meta
			property="og:image"
			content="https://imicola.com/chongqing/og.png"
		/>
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<header class="cq-header">
			<a class="cq-brand" href="#top"
				><b>CQ</b><span>重庆旅行控制台</span></a
			>
			<button class="cq-menu" type="button" aria-expanded="false"
				>菜单</button
			>
			<nav aria-label="专题导航">
				<a href="#today">今天怎么玩</a><a href="#modules">模块库</a><a
					href="#pois">POI情报</a
				><a href="#food">吃什么</a><a href="#specials">专项</a><a
					href="#guide">总控</a
				><a href="/hub/">返回Hub</a>
			</nav>
		</header>

		<main id="top">
			<section class="cq-archived" aria-label="归档说明">
				<b>ARCHIVED · 已归档</b>
				<span
					>行程已于 2026-08-22
					结束。本页面转为行程记录，内容不再更新，可作复盘与参考。</span
				>
			</section>

			<section class="cq-hero">
				<div class="cq-hero-copy">
					<p class="cq-eyebrow">
						6 STUDENTS · 9 DAYS · ONE HOME BASE
					</p>
					<h1>不是赶路。<br /><span>是随时选路。</span></h1>
					<p>
						2026.08.14—08.22 · 重庆六人自由行<br />吃 ≈ 城市空间
						&gt; 出片 &gt; 夜景 &gt; 自然
					</p>
					<div class="cq-hero-actions">
						<a href="#today">开始今天的决策</a><a
							class="secondary"
							href="/chongqing/chongqing-travel-guide.pdf"
							download>下载离线PDF</a
						>
					</div>
				</div>
				<div class="cq-facts">
					<div>
						<span>住宿基地</span><b>富城大厦 · 北区路14号</b><small
							>地图搜“富城大厦（一号桥）”</small
						>
					</div>
					<div>
						<span>软预算</span><b>1,000元 / 人</b><small
							>住宿与深渝大交通不计</small
						>
					</div>
					<div>
						<span>去程</span><b>G2944 · 深圳北 08:21</b><small
							>重庆西15:11；以本人12306车票为准</small
						>
					</div>
					<div>
						<span>返程 · 8/22</span><b>重庆北16:52 / 16:56</b><small
							>Z334（5人）· D2255（1人）</small
						>
					</div>
				</div>
				<div class="cq-live" aria-live="polite">
					<span id="live-label">北京时间识别中</span><b
						id="live-title">正在定位今日模式</b
					><p id="live-note">
						加载后会自动匹配出发前、行程日或返程后的状态。
					</p>
				</div>
			</section>

			<section class="cq-mode-strip">
				<div>
					<b>38℃模式</b><span>13:00–17:00不走长线，户外压到傍晚</span>
				</div><div>
					<b>雨天模式</b><span>博物馆/商圈/民宿；雷雨不靠江</span>
				</div><div>
					<b>腿废模式</b><span
						>单模块+两段网约车，恢复是在保护明天</span
					>
				</div><div>
					<b>桌游模式</b><span>外卖、补水、空调；21:00再决定夜宵</span
					>
				</div>
			</section>

			<section class="cq-section cq-router" id="today">
				<div class="cq-heading">
					<span>01</span><div>
						<p class="cq-eyebrow">DAILY ROUTER</p><h2>
							今天怎么玩？
						</h2><p>
							日期只给默认值，真实天气、体力和兴趣拥有最终决定权。
						</p>
					</div>
				</div>
				<div class="cq-choices">
					<fieldset data-choice="weather">
						<legend>天气</legend><div>
							<button class="active">炎热</button><button
								>正常</button
							><button>下雨</button>
						</div>
					</fieldset>
					<fieldset data-choice="energy">
						<legend>体力</legend><div>
							<button>满血</button><button class="active"
								>正常</button
							><button>腿废了</button>
						</div>
					</fieldset>
					<fieldset data-choice="interest">
						<legend>兴趣</legend><div>
							<button class="active">吃</button><button
								>CityWalk</button
							><button>拍照</button><button>自然</button><button
								>夜景</button
							><button>摆烂</button>
						</div>
					</fieldset>
				</div>
				<div class="cq-date-context">
					<b id="router-day">非行程日 · 手动试算</b><span
						id="router-note"
						>正式旅行日会按北京时间载入当天的默认天气与兴趣。</span
					>
				</div>
				<div class="cq-rec-head">
					<b id="rec-label">TOP 3</b><button
						id="shuffle"
						type="button">换一组同分选项</button
					>
				</div>
				<div class="cq-recs" id="recommendations"></div>
			</section>

			<section class="cq-section" id="weather">
				<div class="cq-heading">
					<span>02</span><div>
						<p class="cq-eyebrow">WEATHER WINDOW</p><h2>
							天气不是背景，是路由器
						</h2><p>
							2026-08-11快照；出发前24–48小时必须重查，武隆必须独立复核。
						</p>
					</div>
				</div>
				<div class="cq-weather">
					{
						weather.map((day) => (
							<article>
								<>
									<div>
										<>
											<b>{day[0]}</b>
											<span>{day[1]}</span>
										</>
									</div>
									<strong>{day[2]}</strong>
									<p>{day[3]}</p>
								</>
							</article>
						))
					}
				</div>
			</section>

			<section class="cq-section" id="modules">
				<div class="cq-heading">
					<span>03</span><div>
						<p class="cq-eyebrow">12 SWAPPABLE MODULES</p><h2>
							模块库，不是死日程
						</h2><p>每个模块都能独立成立，也能按天气和体力互换。</p>
					</div>
				</div>
				<div class="cq-module-grid">
					{
						modules.map((item, index) => (
							<article id={item.id}>
								<>
									<div class="cq-number">
										{String(index + 1).padStart(2, "0")}
									</div>
									<p class="cq-eyebrow">{item.area}</p>
									<h3>{item.title}</h3>
									<p>{item.route}</p>
									<div class="cq-metrics">
										<>
											<span>{item.time}</span>
											<span>{item.duration}</span>
											<span>{item.cost}</span>
										</>
									</div>
									<div class="cq-rating">
										<>
											<span>
												体力 {"★".repeat(item.effort)}
											</span>
											<span>
												出片 {"★".repeat(item.photo)}
											</span>
											<span>
												吃饭 {"★".repeat(item.food)}
											</span>
										</>
									</div>
									<footer>
										<>
											<b>放弃条件</b>
											<span>{item.skip}</span>
										</>
									</footer>
								</>
							</article>
						))
					}
				</div>
			</section>

			<section class="cq-section" id="pois">
				<div class="cq-heading">
					<span>04</span><div>
						<p class="cq-eyebrow">17 FIELD CARDS</p><h2>
							现在值不值得去？
						</h2><p>
							S是强推荐，A是值得，B是条件式选择。标记仅保存在当前设备。
						</p>
					</div>
				</div>
				<div class="cq-pois">
					{
						pois.map((poi, index) => (
							<article>
								<>
									<header>
										<>
											<span
												class={`cq-grade grade-${String(poi[1]).toLowerCase()}`}
											>
												{poi[1]}
											</span>
											<div>
												<>
													<small>
														POI{" "}
														{String(
															index + 1,
														).padStart(2, "0")}
													</small>
													<h3>{poi[0]}</h3>
												</>
											</div>
											<button
												class="cq-save"
												data-poi={String(poi[0])}
											>
												未标记
											</button>
										</>
									</header>
									<p class="cq-verdict">{poi[2]}</p>
									<dl>
										<>
											<div>
												<>
													<dt>入口/走法</dt>
													<dd>{poi[3]}</dd>
												</>
											</div>
											<div>
												<>
													<dt>费用</dt>
													<dd>{poi[4]}</dd>
												</>
											</div>
											<div>
												<>
													<dt>停留</dt>
													<dd>{poi[5]}</dd>
												</>
											</div>
										</>
									</dl>
								</>
							</article>
						))
					}
				</div>
			</section>

			<section class="cq-section cq-food" id="food">
				<div class="cq-heading">
					<span>05</span><div>
						<p class="cq-eyebrow">
							FOOD CONTROL ROOM · 12 PICKS
						</p><h2>吃什么，比去哪吃重要</h2><p>
							先看位置，再看口味、预算和等待成本。人均是参考预算，不是承诺菜单价。
						</p>
					</div>
				</div>
				<div class="cq-food-rules">
					<article>
						<b>火锅 · 约540–720元/桌</b><p>
							10–12份菜起步，毛肚/鸭肠/嫩肉/黄喉选4–5份，素菜4–5份。
						</p>
					</article><article>
						<b>江湖菜 · 约420–660元/桌</b><p>
							4道主菜+2道蔬菜+汤或主食，避免六道全是红油干锅。
						</p>
					</article><article>
						<b>小吃 · 约180–360元/队</b><p>
							每人买一种，全队分食；同类碳水只留一个。
						</p>
					</article><article>
						<b>不辣成员 · 先保底</b><p>
							先点确定不辣的主食/汤，再讨论共享菜；逐道确认。
						</p>
					</article>
				</div>
				<div class="cq-food-filter">
					<div data-filter="area">
						<b>区域</b>{
							foodAreas.map((area, index) => (
								<button
									class:list={[{ active: index === 0 }]}
									data-value={area}
								>
									{area}
								</button>
							))
						}
					</div><div data-filter="kind">
						<b>品类</b>{
							foodKinds.map((kind, index) => (
								<button
									class:list={[{ active: index === 0 }]}
									data-value={kind}
								>
									{kind}
								</button>
							))
						}
					</div>
				</div>
				<p class="cq-count" id="food-count">
					显示 {foods.length} / {foods.length} 个候选
				</p>
				<div class="cq-food-cards">
					{
						foods.map((item) => (
							<article data-area={item[1]} data-kind={item[2]}>
								<>
									<header>
										<>
											<span
												class={`cq-grade grade-${String(item[3]).toLowerCase()}`}
											>
												{item[3]}
											</span>
											<div>
												<>
													<small>
														{item[1]} · {item[2]}
													</small>
													<h3>{item[0]}</h3>
												</>
											</div>
											<strong>{item[4]}</strong>
										</>
									</header>
									<div class="cq-verdict">
										<>
											<b>本团评价</b>
											<p>{item[6]}</p>
										</>
									</div>
									<dl>
										<>
											<div>
												<>
													<dt>位置</dt>
													<dd>{item[5]}</dd>
												</>
											</div>
											<div>
												<>
													<dt>点单/排队</dt>
													<dd>{item[7]}</dd>
												</>
											</div>
										</>
									</dl>
									<footer>
										<a
											href={item[8]}
											target="_blank"
											rel="noreferrer"
										>
											打开地图 ↗
										</a>
									</footer>
								</>
							</article>
						))
					}
				</div>
			</section>

			<section class="cq-section" id="specials">
				<div class="cq-heading">
					<span>06</span><div>
						<p class="cq-eyebrow">SPECIAL OPERATIONS</p><h2>
							复杂项目怎么嵌入路线
						</h2>
					</div>
				</div>
				<div class="cq-specials">
					<article>
						<p class="cq-eyebrow">CABLEWAY</p><h3>
							长江索道
						</h3><strong>单程30元 · 往返50元</strong><p>
							南岸模块结束后南→北最顺。索道是跨江体验，不是观景台；等待超过45分钟就坐轨道。
						</p>
					</article><article>
						<p class="cq-eyebrow">RIVER</p><h3>
							两江小渡B线
						</h3><strong>弹子石18:30 · 15元</strong><p>
							便宜但接驳成本要计入。雷雨、大风、水位异常时停航；它不是传统朝天门夜游。
						</p>
					</article><article>
						<p class="cq-eyebrow">WULONG</p><h3>天生三桥</h3><strong
							>学生Pass 98.5元 · 二消另计</strong
						><p>
							天气、往返票、景区接驳三项都稳才启动。若只选一个景点，优先天生三桥，不硬塞地缝。
						</p>
					</article>
				</div>
			</section>

			<section class="cq-section" id="guide">
				<div class="cq-heading">
					<span>07</span><div>
						<p class="cq-eyebrow">FIELD GUIDE</p><h2>
							九天骨架与返程硬缓冲
						</h2>
					</div>
				</div>
				<div class="cq-days">
					{
						tripDays.map((day) => (
							<article>
								<>
									<b>{day.short}</b>
									<strong>{day.title}</strong>
									<p>{day.note}</p>
								</>
							</article>
						))
					}
				</div>
				<div class="cq-return">
					<div>
						<p class="cq-eyebrow">8/22 RETURN DAY</p><h3>
							13:30前离开住宿地
						</h3><p>
							轻午饭 → 取行李 → 重庆北站。五人Z334
							16:52去深圳东，一人D2255
							16:56去成都东。不要在返程日安排景点。
						</p>
					</div><a
						href="/chongqing/chongqing-travel-guide.pdf"
						download>下载16页离线旅行手册</a
					>
				</div>
			</section>

			<section class="cq-section cq-sources">
				<div class="cq-heading">
					<span>08</span><div>
						<p class="cq-eyebrow">SOURCE LOG</p><h2>
							关键来源与复核
						</h2><p>
							最后核验日期：2026-08-11。营业、票价、天气和交通均以出行当日官方渠道为准。
						</p>
					</div>
				</div>
				<div>
					{
						sources.map((source) => (
							<a
								href={source[1]}
								target="_blank"
								rel="noreferrer"
							>
								<>
									<span>{source[0]}</span>
									<b>查看原文 ↗</b>
								</>
							</a>
						))
					}
				</div>
			</section>
		</main>

		<footer class="cq-footer">
			<div>
				<b>重庆旅行控制台</b><p>
					体验密度 &gt; 景点数量 · 顺路 &gt; 网红排名
				</p>
			</div><a href="/hub/">返回 imicola Hub →</a>
		</footer>

		<script is:inline define:vars={{ modules, tripDays }}>
			const state = {
				weather: "炎热",
				energy: "正常",
				interest: "吃",
				nonce: 0,
			};
			const dateKey = () =>
				new Intl.DateTimeFormat("en-CA", {
					timeZone: "Asia/Shanghai",
					year: "numeric",
					month: "2-digit",
					day: "2-digit",
				}).format(new Date());
			const distance = (from, to) =>
				Math.round(
					(Date.parse(`${to}T00:00:00Z`) -
						Date.parse(`${from}T00:00:00Z`)) /
						86400000,
				);
			const today = dateKey();
			const activeDay = tripDays.find((day) => day.iso === today);
			const before = distance(today, tripDays[0].iso);
			const after = today > tripDays[tripDays.length - 1].iso;
			document.querySelector("#live-label").textContent = activeDay
				? `${activeDay.day} · ${activeDay.short}`
				: before > 0
					? `距出发 ${before} 天`
					: after
						? "行程已结束"
						: "行程准备期";
			document.querySelector("#live-title").textContent =
				activeDay?.title ||
				(before > 0
					? "出发前核验模式"
					: after
						? "复盘与收藏"
						: "等待出发");
			document.querySelector("#live-note").textContent =
				activeDay?.note ||
				(before > 0
					? "车票、天气、武隆与餐厅只做最后核验，不再堆叠新景点。"
					: "页面仍可用于手动试算模块。");
			if (activeDay) {
				state.weather = activeDay.weather;
				state.interest = activeDay.interest;
				document.querySelector("#router-day").textContent =
					`${activeDay.day} · ${activeDay.title}`;
				document.querySelector("#router-note").textContent =
					`已用 ${activeDay.short} 预案初始化；下方选项仍可手动覆盖。`;
			}
			const score = (item) => {
				let value = 0;
				if (item.weather.includes(state.weather)) value += 5;
				if (item.energy.includes(state.energy)) value += 5;
				if (item.interests.includes(state.interest)) value += 7;
				if (state.weather === "炎热")
					value += Math.max(0, 4 - item.sun);
				if (state.weather === "下雨")
					value +=
						item.rain === "适合"
							? 5
							: item.rain === "可用"
								? 1
								: -8;
				if (state.energy === "腿废了")
					value += Math.max(0, 4 - item.effort) * 2;
				if (state.interest === "拍照") value += item.photo;
				if (state.interest === "吃") value += item.food;
				if (state.interest === "摆烂" && item.id === "recovery")
					value += 10;
				return value + (state.nonce ? Math.random() * 1.8 : 0);
			};
			const renderRecommendations = () => {
				const picks = [...modules]
					.map((item) => ({ item, score: score(item) }))
					.sort((a, b) => b.score - a.score)
					.slice(0, 3);
				document.querySelector("#rec-label").textContent =
					`TOP 3 / ${state.weather} · ${state.energy} · ${state.interest}`;
				document.querySelector("#recommendations").innerHTML = picks
					.map(
						({ item }, index) =>
							`<article><div class="cq-number">0${index + 1}</div><p class="cq-eyebrow">${item.area}</p><h3>${item.title}</h3><p>${item.route}</p><div class="cq-metrics"><span>${item.time}</span><span>${item.duration}</span><span>${item.cost}</span></div><footer><b>放弃条件</b><span>${item.skip}</span></footer><a href="#${item.id}">查看模块细节 →</a></article>`,
					)
					.join("");
			};
			document.querySelectorAll("[data-choice]").forEach((field) => {
				const key = field.dataset.choice;
				field.querySelectorAll("button").forEach((button) => {
					button.classList.toggle(
						"active",
						button.textContent === state[key],
					);
					button.addEventListener("click", () => {
						state[key] = button.textContent;
						field
							.querySelectorAll("button")
							.forEach((item) => item.classList.remove("active"));
						button.classList.add("active");
						renderRecommendations();
					});
				});
			});
			document.querySelector("#shuffle").addEventListener("click", () => {
				state.nonce += 1;
				renderRecommendations();
			});
			renderRecommendations();

			const foodState = { area: "全部", kind: "全部" };
			const filterFood = () => {
				let visible = 0;
				document
					.querySelectorAll(".cq-food-cards > article")
					.forEach((card) => {
						const showArea =
							foodState.area === "全部" ||
							card.dataset.area.includes(foodState.area);
						const showKind =
							foodState.kind === "全部" ||
							card.dataset.kind === foodState.kind;
						card.hidden = !(showArea && showKind);
						if (!card.hidden) visible += 1;
					});
				document.querySelector("#food-count").textContent =
					`显示 ${visible} / ${document.querySelectorAll(".cq-food-cards > article").length} 个候选`;
			};
			document.querySelectorAll("[data-filter]").forEach((row) =>
				row.querySelectorAll("button").forEach((button) =>
					button.addEventListener("click", () => {
						foodState[row.dataset.filter] = button.dataset.value;
						row.querySelectorAll("button").forEach((item) =>
							item.classList.remove("active"),
						);
						button.classList.add("active");
						filterFood();
					}),
				),
			);

			document.querySelectorAll(".cq-save").forEach((button) => {
				const key = `cq-poi-${button.dataset.poi}`;
				const values = ["未标记", "想去", "去过了"];
				let current = Number(localStorage.getItem(key) || 0);
				button.textContent = values[current];
				button.dataset.state = current;
				button.addEventListener("click", () => {
					current = (current + 1) % values.length;
					localStorage.setItem(key, String(current));
					button.textContent = values[current];
					button.dataset.state = current;
				});
			});
			const menu = document.querySelector(".cq-menu");
			const nav = document.querySelector(".cq-header nav");
			menu.addEventListener("click", () => {
				const open = nav.classList.toggle("open");
				menu.setAttribute("aria-expanded", String(open));
			});
			nav.querySelectorAll("a").forEach((link) =>
				link.addEventListener("click", () => {
					nav.classList.remove("open");
					menu.setAttribute("aria-expanded", "false");
				}),
			);
		</script>
	</body>
</html>

