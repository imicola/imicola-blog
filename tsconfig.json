{
	"extends": "astro/tsconfigs/strict",
	"include": ["src/**/*"],
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"strictNullChecks": true,
		"allowJs": false,
		"baseUrl": ".",
		"declaration": true,
		"plugins": [
			{
				"name": "@astrojs/ts-plugin"
			}
		],
		"paths": {
			"@/*": ["src/*"],
			"@components/*": ["src/components/*"],
			"@utils/*": ["src/utils/*"],
			"@layouts/*": ["src/layouts/*"],
			"@i18n/*": ["src/i18n/*"],
			"@constants/*": ["src/constants/*"],
			"@assets/*": ["src/assets/*"]
		}
	}
}
